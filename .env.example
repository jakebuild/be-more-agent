# Brain Settings
BRAIN_TYPE=openclaw

# OpenClaw Settings
OPENCLAW_URL=https://your-hostname.tailnet-id.ts.net/v1/chat/completions
OPENCLAW_TOKEN=your-secret-token-here
OPENCLAW_MODEL=openclaw:main
INPUT_DEVICE=pulse
OUTPUT_DEVICE=pulse

# Telegram Settings
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id
TELEGRAM_MENTION=@builder_md_bot
TELEGRAM_APP_ID=your-app-id
TELEGRAM_APP_HASH=your-app-hash
